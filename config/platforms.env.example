# Bio-One Social — platform credentials (copy to platforms.env, keep secret)
# Fill these in as each platform's developer app is approved, then flip
# liveReady:true in the matching lib/providers/*.js meta().

# --- Meta (Facebook + Instagram share one app) ---
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/oauth/meta/callback

# --- LinkedIn ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/oauth/linkedin/callback

# --- X (Twitter) — requires paid API tier ---
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- TikTok ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Pinterest ---
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# Secret used to encrypt stored OAuth tokens at rest (generate a random 32+ char string)
TOKEN_ENCRYPTION_KEY=
