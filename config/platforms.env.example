# Bio-One Social — platform credentials (copy to config/platforms.env, keep secret).
# Setting META_APP_ID + META_APP_SECRET automatically switches Facebook &
# Instagram from demo mode to LIVE (real OAuth + publishing). No code change.
# On Render, set these in the dashboard (Environment) instead of this file.

# --- Public URL of the deployed app (used for OAuth redirect + media URLs) ---
# Meta must be able to fetch post images/videos from here, and the OAuth
# redirect must match what's registered in the Meta app.
APP_BASE_URL=https://bio-one-social-hub.onrender.com

# --- Encrypt stored OAuth tokens at rest (any long random string, 32+ chars) ---
TOKEN_ENCRYPTION_KEY=

# --- Meta (Facebook + Instagram share one app) ---
# Redirect URI to register in the Meta app: <APP_BASE_URL>/oauth/meta/callback
META_APP_ID=
META_APP_SECRET=

# --- LinkedIn ---
# Setting these flips LinkedIn from demo to LIVE (Company Page publishing).
# Redirect URI to register in the LinkedIn app: <APP_BASE_URL>/oauth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LINKEDIN_API_VERSION=202506   # override if LinkedIn sunsets this version

# --- X (Twitter) — requires paid API tier ---
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- TikTok ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Pinterest ---
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# Secret used to encrypt stored OAuth tokens at rest (generate a random 32+ char string)
TOKEN_ENCRYPTION_KEY=
